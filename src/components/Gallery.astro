<section>
  <div class="gallery-head">
    <div>
      <h2>El álbum de Jafet</h2><p>Fotos y videos compartidos con cariño.</p>
    </div><div class="filters" aria-label="Filtrar recuerdos">
      <template x-for="option in ['all', 'photo', 'video']"
        ><button
          :class="{ active: filter === option }"
          @click="filter = option; expanded = false"
          x-text="{ all: 'Todos', photo: 'Fotos', video: 'Videos' }[option]"
        ></button></template
      >
    </div>
  </div><div class="gallery-stage">
    <p class="gallery-status" x-show="galleryLoading" aria-live="polite">
      Cargando recuerdos…
    </p>
    <p class="gallery-status" x-show="!galleryLoading && !visible.length">
      Aún no hay recuerdos publicados.
    </p>
    <div class="grid">
      <template x-for="(memory, index) in shown" :key="memory.src"
        ><button
          class="card"
          :class="[memory.size, `tile-${index % 5}`]"
          @click="open(memory)"
          ><template x-if="memory.type === 'photo'"
            ><img
              :src="memory.src"
              :alt="memory.alt"
              :style="`object-position: ${memory.focus}`"
              loading="lazy"
            /></template
          ><template x-if="memory.type === 'video' && memory.poster"
            ><img
              :src="memory.poster"
              :alt="memory.alt"
              :style="`object-position: ${memory.focus}`"
              @error="clearBrokenPoster(memory)"
              loading="lazy"
            /></template
          ><video
            x-show="memory.type === 'video' && !memory.poster && !memory.posterFailed"
            :src="memory.type === 'video' ? memory.src : ''"
            @loadedmetadata="scheduleVideoFallback(memory)"
            @loadeddata="memory.videoReady = true; captureVideoPoster(memory, $event)"
            @seeked="captureVideoPoster(memory, $event)"
            @error="markVideoPosterFailed(memory)"
            preload="auto"
            muted
            playsinline
            aria-hidden="true"></video><span
            class="video-preview-fallback"
            x-show="memory.type === 'video' && memory.posterFailed"
            ><svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              aria-hidden="true"
              ><path
                d="M4 7.5A2.5 2.5 0 0 1 6.5 5h11A2.5 2.5 0 0 1 20 7.5v9a2.5 2.5 0 0 1-2.5 2.5h-11A2.5 2.5 0 0 1 4 16.5v-9Z"
              ></path><path d="m10 9 5 3-5 3V9Z"></path></svg
            ><span>Vista previa no disponible</span></span
          ><span class="play" x-show="memory.type === 'video'"
            ><svg viewBox="0 0 24 24" fill="currentColor"
              ><path d="m8 5 11 7-11 7V5z"></path></svg
            ></span
          ><span class="card-label" x-text="memory.by"></span></button
        ></template
      >
    </div><button
      class="gallery-more"
      x-show="hasOverflow"
      @click="expanded = !expanded"
      :aria-expanded="expanded"
      ><span x-text="expanded ? 'Ver menos' : 'Ver más'"></span><svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        :class="{ flipped: expanded }"
        aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg
      ></button
    >
  </div>
</section>

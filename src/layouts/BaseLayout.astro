---
import "../styles/global.css";
import Toast from "../components/Toast.astro";
interface Props {
  title: string;
  app?: "memorial" | "management";
}
const { title, app = "memorial" } = Astro.props;
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;
---

<!doctype html>
<html
  lang="es"
  x-data={app === "management" ? "management()" : "memorial()"}
  x-init="init()"
  :class={app === "memorial" ? "{ 'modal-open': modal }" : undefined}
  @keydown.arrow-left={app === "memorial" ? "previous()" : undefined}
  @keydown.arrow-right={app === "memorial" ? "next()" : undefined}
>
  <head
    ><meta charset="UTF-8" /><link
      rel="icon"
      type="image/x-icon"
      href="/favicon.ico?v=1"
      sizes="any"
    /><meta name="viewport" content="width=device-width" /><meta
      name="theme-color"
      content="#121211"
    /><title>{title}</title><link
      rel="preconnect"
      href="https://fonts.googleapis.com"
    /><link
      rel="preconnect"
      href="https://fonts.gstatic.com"
      crossorigin
    /><link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,500;0,600;1,500&display=swap"
      rel="stylesheet"
    />{
      turnstileSiteKey && (
        <>
          <script is:inline define:vars={{ turnstileSiteKey }}>
            window.yepoTurnstileSiteKey = turnstileSiteKey;
          </script>
          <script
            is:inline
            src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit"
            defer
          />
        </>
      )
    }</head
  ><body
    ><slot /><Toast /><script>
      import "../scripts/app.ts";
    </script></body
  >
</html>
